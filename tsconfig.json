{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "jsx": "react-jsx", "strict": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["src", "tests", "scripts", "vite.config.ts"]
}
