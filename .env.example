# Safe offline default. npm start does NOT load this file automatically.
# After copying to .env, use:
# node --env-file=.env dist/server/server/index.js
AI_ADAPTER=mock
PORT=3100
GAME_DATA_DIR=data

# Optional initial world and profile files (operator-controlled paths)
# GAME_WORLD_FILE=content/worlds/town.json
# PROMPT_PROFILE_PATH=content/profiles/default.json

# Codex subscription mode: existing local CLI + ChatGPT login; no API key.
# AI_ADAPTER=codex
# CODEX_PATH=/absolute/path/to/codex
# CODEX_MODEL=your-available-model

# OpenAI Responses adapter; model names below are current CODE defaults,
# not a guarantee of availability for your account.
# AI_ADAPTER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_OUTPUT_TOKENS=12000

# DeepSeek Responses adapter; confirm /responses support with your provider.
# AI_ADAPTER=deepseek
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MAX_OUTPUT_TOKENS=12000

# Optional inherited network settings. Do not commit proxy credentials.
# HTTP_PROXY=http://127.0.0.1:PORT
# HTTPS_PROXY=http://127.0.0.1:PORT
# NO_PROXY=localhost,127.0.0.1

# Optional browser-smoke executable (not needed to run the game)
# BROWSER_EXECUTABLE=/absolute/path/to/chromium
